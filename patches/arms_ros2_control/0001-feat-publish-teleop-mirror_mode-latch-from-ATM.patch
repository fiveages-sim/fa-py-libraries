From a57741d601566b0ec1944a3a4a93e7e72e84026c Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 3 Nov 2026 12:05:55 +0000
Subject: [PATCH] feat: publish /teleop/mirror_mode latch from ATM

Expose the same mirror_mode_ bit used for EE/trigger cross-mapping so hand
sinks can follow a TRANSIENT_LOCAL level instead of racing event-7 pulses.
---
 .../arms_target_manager/VRInputHandler.h      |  6 +++++
 .../src/VRInputHandler.cpp                    | 23 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/command/arms_target_manager/include/arms_target_manager/VRInputHandler.h b/command/arms_target_manager/include/arms_target_manager/VRInputHandler.h
index 4ee90e8..90b7cb0 100644
--- a/command/arms_target_manager/include/arms_target_manager/VRInputHandler.h
+++ b/command/arms_target_manager/include/arms_target_manager/VRInputHandler.h
@@ -16,6 +16,7 @@
 #include <geometry_msgs/msg/twist.hpp>
 #include <Eigen/Core>
 #include <Eigen/Geometry>
+#include <std_msgs/msg/bool.hpp>
 #include <std_msgs/msg/float64.hpp>
 #include <std_msgs/msg/int32.hpp>
 #include <std_msgs/msg/string.hpp>
@@ -360,6 +361,9 @@ namespace arms_ros2_control::command
          */
         void runScaleCalibration(bool use_left_z);
 
+        /** Publish latch of mirror_mode_ on /teleop/mirror_mode (TRANSIENT_LOCAL). */
+        void publishMirrorMode();
+
         /**
          * 按镜像模式解析左右扳机对应的手控制器
          * @param is_left_trigger true=左扳机, false=右扳机
@@ -581,6 +585,8 @@ namespace arms_ros2_control::command
 
         // WBC 模式切换命令发布器（case 21–24 请求身体模式）
         rclcpp::Publisher<std_msgs::msg::String>::SharedPtr pub_mode_command_;
+        // Level latch for hand sinks / DualHand (same bit as EE/trigger mirror).
+        rclcpp::Publisher<std_msgs::msg::Bool>::SharedPtr pub_mirror_mode_;
         rclcpp::Subscription<arms_ros2_control_msgs::msg::WbcCapability>::SharedPtr
             sub_wbc_capability_;
 
diff --git a/command/arms_target_manager/src/VRInputHandler.cpp b/command/arms_target_manager/src/VRInputHandler.cpp
index f2b2b0b..e604b7e 100644
--- a/command/arms_target_manager/src/VRInputHandler.cpp
+++ b/command/arms_target_manager/src/VRInputHandler.cpp
@@ -12,6 +12,7 @@
 #include <geometry_msgs/msg/twist.hpp>
 #include <arms_ros2_control_msgs/msg/wbc_current_state.hpp>
 #include <arms_ros2_control_msgs/msg/wbc_capability.hpp>
+#include <std_msgs/msg/bool.hpp>
 #include <std_msgs/msg/float64.hpp>
 #include <std_msgs/msg/int32.hpp>
 #include <nav_msgs/msg/path.hpp>
@@ -214,6 +215,15 @@ namespace arms_ros2_control::command
         // WBC 模式切换命令发布器（case 21–24 请求身体模式）
         pub_mode_command_ = node_->create_publisher<std_msgs::msg::String>("mode_command", 10);
 
+        // Hand sinks / DualHand follow this latch (same bit as EE/trigger mirror).
+        pub_mirror_mode_ = node_->create_publisher<std_msgs::msg::Bool>(
+            "/teleop/mirror_mode",
+            rclcpp::QoS(1).transient_local());
+        publishMirrorMode();
+        RCLCPP_INFO(
+            node_->get_logger(),
+            "🕹️🕶️🕹️ Publishing /teleop/mirror_mode (Bool, transient_local)");
+
         sub_wbc_capability_ =
             node_->create_subscription<arms_ros2_control_msgs::msg::WbcCapability>(
                 "ocs2_wbc_controller/wbc_capabilities",
@@ -470,11 +480,23 @@ namespace arms_ros2_control::command
                     right_gripper_percent_mode_.load() ? "比例" : "开关");
     }
 
+    void VRInputHandler::publishMirrorMode()
+    {
+        if (!pub_mirror_mode_)
+        {
+            return;
+        }
+        std_msgs::msg::Bool msg;
+        msg.data = mirror_mode_.load();
+        pub_mirror_mode_->publish(msg);
+    }
+
     void VRInputHandler::runScaleCalibration(bool use_left_z)
     {
         const char* tag = use_left_z ? "左组合键" : "右组合键";
 
         mirror_mode_.store(false);
+        publishMirrorMode();
         RCLCPP_INFO(node_->get_logger(), "🔘 [%s] 已切换至非镜像模式", tag);
         is_update_mode_.store(false);
         stopHeadTracking();
@@ -3644,6 +3666,7 @@ namespace arms_ros2_control::command
                 bool old_mirror_mode = mirror_mode_.load();
                 bool new_mirror_mode = !old_mirror_mode;
                 mirror_mode_.store(new_mirror_mode);
+                publishMirrorMode();
                 if (!new_mirror_mode)
                 {
                     mirror_mode_profile_.store(static_cast<int>(MirrorModeProfile::MODE_A));
-- 
